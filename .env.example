# Database
# Use a strong, random POSTGRES_PASSWORD in production (e.g. `openssl rand -hex 24`)
# and keep DATABASE_URL in sync with it.
DATABASE_URL=postgresql://kryptoskatt:kryptoskatt@db:5432/kryptoskatt
# Postgres image tag. Defaults to postgres:18-alpine. When upgrading an existing
# instance, pin this to your current major (e.g. postgres:16-alpine) to avoid a
# dump/restore of the data volume.
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=kryptoskatt
POSTGRES_PASSWORD=kryptoskatt
POSTGRES_DB=kryptoskatt

# API Keys — all optional; the site runs without any of them (free/keyless
# sources are used: Blockscout for ETH/Base/Arbitrum/Polygon, Blockstream for
# BTC, XRPL cluster, CoinGecko/Binance/Kraken public prices). Free-tier keys
# widen coverage (e.g. Solana via Helius, BNB via Etherscan) at no cost.
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
SOLSCAN_API_KEY=
COINGECKO_API_KEY=
SUBSCAN_API_KEY=
TRONSCAN_API_KEY=
VECHAINSTATS_API_KEY=
COINAPI_API_KEY=

# Security
COOKIE_SECURE=true   # set to false in local dev without HTTPS
CORS_ORIGINS=["https://yourdomain.com"]
# REQUIRED to let users store API keys: encrypts them at rest. Without it,
# storing keys is refused (never plaintext). Generate: openssl rand -hex 32
SECRET_KEY=

# Legal / privacy (shown in /integritet and /villkor — GDPR art. 13 requires it)
OPERATOR_NAME=
OPERATOR_CONTACT=
# Accounts unused this long are deleted at start-up and by `kryptoskatt purge-inactive`
INACTIVE_ACCOUNT_MONTHS=24
# HTTP access logs store client IPs and share-link tokens; keep off unless needed
ACCESS_LOG=false

# Logging
LOG_LEVEL=INFO

# Server (Docker)
# Keep WEB_CONCURRENCY=1 unless you run a distributed rate limiter/job queue —
# the built-in ones are per-process.
WEB_CONCURRENCY=1
# Your reverse proxy's IP/CIDR (X-Forwarded-* headers are trusted only from here).
# MUST be set when the proxy runs in another container, otherwise every user
# shares the proxy's IP for login rate limiting.
FORWARDED_ALLOW_IPS=127.0.0.1

# Debug routes — set to true only in local dev, never in production
DEBUG_MODE=false

# Price history directory
PRICE_HISTORY_DIR=PriceHistory
