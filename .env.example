# Database
# Use a strong, random POSTGRES_PASSWORD in production (e.g. `openssl rand -hex 24`)
# and keep DATABASE_URL in sync with it.
DATABASE_URL=postgresql://kryptoskatt:kryptoskatt@db:5432/kryptoskatt
POSTGRES_USER=kryptoskatt
POSTGRES_PASSWORD=kryptoskatt
POSTGRES_DB=kryptoskatt

# API Keys (get your own free keys from the respective services)
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
SOLSCAN_API_KEY=
COINGECKO_API_KEY=
SUBSCAN_API_KEY=
TRONSCAN_API_KEY=
VECHAINSTATS_API_KEY=
COINAPI_API_KEY=

# Security
COOKIE_SECURE=true   # set to false in local dev without HTTPS
CORS_ORIGINS=["https://yourdomain.com"]
# Encrypts user secrets (custom chain API keys) at rest — generate with: openssl rand -hex 32
SECRET_KEY=

# Logging
LOG_LEVEL=INFO

# Debug routes — set to true only in local dev, never in production
DEBUG_MODE=false

# Price history directory
PRICE_HISTORY_DIR=PriceHistory
